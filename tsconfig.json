{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@aleksei-chernyi/pathmodel": ["./node_modules/@aleksei-chernyi/pathmodel/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/playground/examples"]
}
